# Copy these values into your shell or a local, untracked .env loader.
STUDYSPACE_KAKAO_ENABLED=true
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_JAVASCRIPT_KEY=replace-with-kakao-javascript-key
# Set this when Kakao Developers has client secret protection enabled.
KAKAO_CLIENT_SECRET=
KAKAO_CLIENT_SECRET_REQUIRED=true
KAKAO_REDIRECT_URI=https://studyspace.omong.kr/api/auth/kakao/callback
STUDYSPACE_PUBLIC_BASE_URL=https://studyspace.omong.kr
STUDYSPACE_COOKIE_SECURE=true
STUDYSPACE_REQUIRE_EMAIL_VERIFICATION=false
# Configure SMTP to deliver password-reset links. Keep credentials only in .env.
STUDYSPACE_MAIL_HOST=smtp.gmail.com
STUDYSPACE_MAIL_PORT=587
STUDYSPACE_MAIL_USERNAME=replace-with-smtp-username
STUDYSPACE_MAIL_PASSWORD=replace-with-smtp-password
STUDYSPACE_MAIL_FROM=replace-with-smtp-username
STUDYSPACE_MAIL_AUTH=true
STUDYSPACE_MAIL_STARTTLS=true

# Docker/MySQL. Use unique long values in the untracked .env file.
STUDYSPACE_DB_PASSWORD=replace-with-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password

# Add only to the local/production .env file. Never commit the actual key.
GEMINI_API_KEY=replace-with-gemini-api-key
# Set true only when you want deterministic local samples; production should use Gemini.
STUDYSPACE_AI_MOCK_ENABLED=false
STUDYSPACE_STORAGE_LIMIT_BYTES=3221225472
